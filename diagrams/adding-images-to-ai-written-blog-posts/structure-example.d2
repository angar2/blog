direction: right

vars: {
  d2-config: {
    pad: 30
  }
}

style.fill: "#17100e"

classes: {
  box: {
    style: {
      fill: "#1e1613"
      stroke: "#3a2d27"
      border-radius: 10
      font-color: "#f3eae6"
      font-size: 22
    }
  }
  accent: {
    style: {
      fill: "#291d19"
      stroke: "#ff5247"
      border-radius: 10
      font-color: "#f3eae6"
      font-size: 22
      bold: true
    }
  }
  edge: {
    style: {
      stroke: "#ff7a70"
      stroke-width: 2
    }
  }
}

글: 글 초안 { class: box }
구조도: 구조도 { class: accent }
독자: 독자 { class: box }

글 -> 구조도: 흐름을 보인다 { class: edge }
구조도 -> 독자: 쉽게 이해한다 { class: edge }
